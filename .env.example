# Скопируйте в .env и при необходимости поправьте.
# Файл .env в git не попадает.

# auto  – live, если задан MOEX_TOKEN, иначе demo
# demo  – синтетические данные, ключи не нужны
# live  – реальные стаканы MOEX и Bybit
DATA_MODE=auto

# Токен MOEX Algopack (нужен только для live-стакана MOEX)
MOEX_TOKEN=

# Bybit: публичный стакан читается БЕЗ ключей, API-ключ не нужен.

POLL_INTERVAL=2          # секунд между опросами
STORE_EVERY=5            # как часто писать точку в SQLite, секунд
RETENTION_DAYS=30        # сколько хранить историю

# Комиссии в долях от цены (за одну ногу)
BYBIT_FEE=0.0001
MOEX_FEE=0.0000066

# Пороги: "дней_с_начала:открыть_%:закрыть_%", через запятую
THRESHOLDS=0:4:2,21:3:2,41:2.5:1

HOST=127.0.0.1
PORT=8000
